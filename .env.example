# Copiar a .env y completar. Nunca commitear el .env real.

DJANGO_SETTINGS_MODULE=furniro_ecommerce.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (solo requerido en production; development usa sqlite)
DATABASE_URL=postgres://user:password@localhost:5432/furniro

# CORS (lista separada por comas, sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF (solo production; necesario para que /admin/ funcione detrás del
# proxy TLS de Railway/Render). Dominios completos con esquema, separados
# por coma. Ej: https://mi-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
