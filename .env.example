# Local: copiar a .env. Producción (Render): cargar estas variables en el dashboard, no hay .env.
# Nunca commitear el .env real.

# Solo tiene efecto si es variable de entorno REAL (shell/plataforma), no desde .env.
#   Local:      furniro_ecommerce.settings.development (SQLite, CORS abierto)
#   Producción: furniro_ecommerce.settings.production
DJANGO_SETTINGS_MODULE=furniro_ecommerce.settings.development

# Generar: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Solo producción. Hostnames sin https:// ni barra final, separados por coma.
DJANGO_ALLOWED_HOSTS=furniro-ecommerce-backend-1h5m.onrender.com

# Solo producción. Postgres del hosting (Render la inyecta al linkear la base).
DATABASE_URL=postgres://user:password@localhost:5432/furniro

# Orígenes del FRONT que pueden consumir la API: con https://, sin barra final, sin espacios.
# Sin el dominio de Vercel acá el navegador bloquea las respuestas.
CORS_ALLOWED_ORIGINS=https://furniro-react-ecommerce.vercel.app,http://localhost:5173,http://localhost:5174

# Solo producción (para que /admin/ funcione tras el proxy TLS). Dominio del BACK con https://
CSRF_TRUSTED_ORIGINS=https://furniro-ecommerce-backend-1h5m.onrender.com

# JWT (opcionales, defaults 30 min / 7 días)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary: imágenes de productos y posts. Sin estas, subir/servir imágenes falla.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
